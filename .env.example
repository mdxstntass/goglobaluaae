# ---- Site ----
SITE_HOST=goglobal-uae.com
LEAD_TITLE=Новый клиент
# Comma-separated; leave empty to allow any origin
ALLOWED_ORIGINS=https://goglobal-uae.com,https://www.goglobal-uae.com

# ---- Webhook (primary destination for the lead JSON) ----
WEBHOOK_URL=https://hooks.tglk.ru/in/XXXXXXXX
# Only if the hook provider requires a bearer token (the URL is usually the secret)
WEBHOOK_TOKEN=

# ---- amoCRM (direct API — optional, only if you bypass the webhook) ----
# amoCRM -> Settings -> Integrations -> your integration -> long-lived token
AMOCRM_BASE_URL=https://yourcompany.amocrm.ru
AMOCRM_TOKEN=
# Optional routing
AMOCRM_PIPELINE_ID=
AMOCRM_RESPONSIBLE_USER_ID=
# Optional custom field ids (amoCRM -> Settings -> Fields)
AMOCRM_FIELD_PHONE=
AMOCRM_FIELD_EMAIL=
AMOCRM_FIELD_INTEREST=
AMOCRM_FIELD_URL=
AMOCRM_FIELD_AMBASSADOR=
AMOCRM_FIELD_COMMENT=

# ---- Email (confirmation to the visitor) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GoGlobal UAE <no-reply@goglobal-uae.com>
# Optional copy of every submission to the sales inbox
MAIL_BCC=
