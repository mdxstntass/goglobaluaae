# ---- Site ----
SITE_HOST=goglobal-uae.com
LEAD_TITLE=Новый клиент
# Comma-separated; leave empty to allow any origin
ALLOWED_ORIGINS=https://goglobal-uae.com,https://www.goglobal-uae.com

# ---- Webhook: the only destination for the lead JSON ----
WEBHOOK_URL=https://hooks.tglk.ru/in/XXXXXXXX
# Only if the hook provider requires a bearer token (the URL is usually the secret)
WEBHOOK_TOKEN=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRIES=2

# ---- Email (confirmation to the visitor) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GoGlobal UAE <no-reply@goglobal-uae.com>
# Optional copy of every submission to the sales inbox
MAIL_BCC=
