# ---- Site ----
SITE_HOST=goglobal-uae.com
LEAD_TITLE=Новый клиент
# Comma-separated; leave empty to allow any origin
ALLOWED_ORIGINS=https://goglobal-uae.com,https://www.goglobal-uae.com

# ---- Webhook: the only destination for the lead JSON ----
WEBHOOK_URL=https://hooks.tglk.ru/in/XXXXXXXX
# Only if the hook provider requires a bearer token (the URL is usually the secret)
WEBHOOK_TOKEN=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRIES=2

# ---- Email (confirmation to the visitor) — Postmark ----
# Postmark uses the Server API Token as BOTH username and password.
# Working ports are 587 and 2525 (STARTTLS). 25, 465 and 8080 are NOT open.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be a verified Sender Signature in Postmark
MAIL_FROM=GoGlobal UAE <admin@goglobal-uae.com>
# Optional copy of every submission to the sales inbox
MAIL_BCC=
